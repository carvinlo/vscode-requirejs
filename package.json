{
  "name": "vscode-requirejs",
  "displayName": "RequireJS Module Support",
  "description": "Looks up modules and identifiers in AMD projects using RequireJS.",
  "version": "2.1.4",
  "homepage": "https://github.com/carvinlo/vscode-requirejs#readme",
  "author": {
    "name": "Carvin Lo",
    "email": "carvin_lo@163.com",
    "url": "https://github.com/carvinlo/vscode-requirejs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carvinlo/vscode-requirejs.git"
  },
  "bugs": {
    "url": "https://github.com/carvinlo/vscode-requirejs/issues"
  },
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/carvinlo/vscode-requirejs/blob/master/LICENSE"
    }
  ],
  "main": "out/extension",
  "scripts": {
    "prepare": "gulp",
    "lint": "denolint",
    "check": "node test/runTest",
    "cover": "c8 node test/runTest",
    "test": "denolint && c8 node test/runTest",
    "version": "npx conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "tehanu": {
    "autostart": false,
    "reporter": "coco"
  },
  "c8": {
    "check-coverage": false,
    "reporter": [
      "text",
      "lcov"
    ],
    "branches": 100,
    "lines": 100,
    "functions": 100,
    "statements": 100
  },
  "dependencies": {
    "@prantlf/amodro-trace": "^2.0.0",
    "@prantlf/requirejs": "^3.0.0",
    "estree-walkie": "^0.0.4",
    "fast-plural-rules": "^1.0.2",
    "glob": "^11.0.2",
    "lru-cache": "^7.13.2",
    "meriyah": "^4.3.0",
    "requirejs-esm": "^2.3.0",
    "vscode-nls": "^5.0.1"
  },
  "devDependencies": {
    "@node-rs/deno-lint": "^1.14.0",
    "@prantlf/vscode-nls-dev": "^5.0.0",
    "@vscode/test-electron": "^2.1.5",
    "c8": "^7.12.0",
    "del": "^6.1.1",
    "event-stream": "^4.0.1",
    "fast-glob": "^3.2.11",
    "gulp": "^4.0.2",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-sourcemaps-identity": "^1.0.0",
    "jsdoc": "^3.6.11",
    "proxyquire": "^2.1.3",
    "sinon": "^14.0.0",
    "tehanu": "^1.0.1",
    "tehanu-repo-coco": "^1.0.0",
    "typescript": "^4.7.4"
  },
  "keywords": [
    "vscode-extension",
    "multi-root ready",
    "requirejs",
    "require",
    "amd"
  ],
  "publisher": "amu",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.5.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onCommand:requireModuleSupport.goToDefinitionModule",
    "onCommand:requireModuleSupport.renameExportedSymbol"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "RequireJS Module Support",
      "properties": {
        "requireModuleSupport.enableDefinitionProvider": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.enableDefinitionProvider%"
        },
        "requireModuleSupport.enableReferenceProvider": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.enableReferenceProvider%"
        },
        "requireModuleSupport.enableCompletionItemProvider": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.enableCompletionItemProvider%"
        },
        "requireModuleSupport.enableHoverProvider": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.enableHoverProvider%"
        },
        "requireModuleSupport.enableRenameProvider": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.enableRenameProvider%"
        },
        "requireModuleSupport.showGoToDefinitionModuleCommand": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.showGoToDefinitionModuleCommand%"
        },
        "requireModuleSupport.showRenameExportedSymbolCommand": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.showRenameExportedSymbolCommand%"
        },
        "requireModuleSupport.configFile": {
          "type": "string",
          "default": "",
          "description": "%requirejs.config.configFile%"
        },
        "requireModuleSupport.enableCjsModules": {
          "type": "boolean",
          "default": false,
          "description": "%requirejs.config.enableCjsModules%"
        },
        "requireModuleSupport.enableJsxModules": {
          "type": "boolean",
          "default": false,
          "description": "%requirejs.config.enableJsxModules%"
        },
        "requireModuleSupport.enableEsModules": {
          "type": "boolean",
          "default": false,
          "description": "%requirejs.config.enableEsModules%"
        },
        "requireModuleSupport.moduleCacheSize": {
          "type": "integer",
          "default": 10000,
          "description": "%requirejs.config.moduleCacheSize%"
        },
        "requireModuleSupport.dynamicModuleCacheSize": {
          "type": "boolean",
          "default": true,
          "description": "%requirejs.config.dynamicModuleCacheSize%"
        },
        "requireModuleSupport.dynamicModuleCacheSizeExtra": {
          "type": "integer",
          "default": 10,
          "description": "%requirejs.config.dynamicModuleCacheSizeExtra%"
        },
        "requireModuleSupport.includeModulePattern": {
          "type": "string",
          "default": "**/*.js",
          "description": "%requirejs.config.includeModulePattern%"
        },
        "requireModuleSupport.excludeModulePattern": {
          "type": "string",
          "default": "",
          "description": "%requirejs.config.excludeModulePattern%"
        },
        "requireModuleSupport.cutFileCompletionExtensions": {
          "type": "array",
          "default": [
            ".js",
            ".jsx",
            ".css",
            ".less",
            ".scss",
            ".hbs",
            ".html"
          ],
          "description": "%requirejs.config.cutFileCompletionExtensions%"
        },
        "requireModuleSupport.includeFileCompletionExtensions": {
          "type": "array",
          "default": [],
          "description": "%requirejs.config.includeFileCompletionExtensions%"
        },
        "requireModuleSupport.excludeFileCompletionExtensions": {
          "type": "array",
          "default": [],
          "description": "%requirejs.config.excludeFileCompletionExtensions%"
        },
        "requireModuleSupport.modulePath": {
          "type": "string",
          "default": "",
          "description": "%requirejs.config.modulePath%"
        },
        "requireModuleSupport.onlyNavigateToFile": {
          "type": "boolean",
          "default": false,
          "description": "%requirejs.config.onlyNavigateToFile%"
        },
        "requireModuleSupport.pluginExtensions": {
          "type": "object",
          "default": {},
          "description": "%requirejs.config.pluginExtensions%"
        },
        "requireModuleSupport.moduleProcessingBatchSize": {
          "type": "number",
          "default": 30,
          "description": "%requirejs.config.moduleProcessingBatchSize%"
        }
      }
    },
    "commands": [
      {
        "command": "requireModuleSupport.goToDefinitionModule",
        "title": "%requirejs.command.goToDefinitionModule.title%"
      },
      {
        "command": "requireModuleSupport.renameExportedSymbol",
        "title": "%requirejs.command.renameExportedSymbol.title%"
      }
    ],
    "keybindings": [
      {
        "command": "requireModuleSupport.goToDefinitionModule",
        "key": "f12",
        "when": "editorLangId == javascript && requireModuleSupport:showGoToDefinitionModuleCommand"
      },
      {
        "command": "requireModuleSupport.renameExportedSymbol",
        "key": "Ctrl+f2",
        "mac": "Cmd+f2",
        "when": "editorLangId == javascript && requireModuleSupport:showRenameExportedSymbolCommand"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "requireModuleSupport.goToDefinitionModule",
          "when": "editorLangId == javascript && requireModuleSupport:showGoToDefinitionModuleCommand",
          "group": "navigation"
        },
        {
          "command": "requireModuleSupport.renameExportedSymbol",
          "when": "editorLangId == javascript && requireModuleSupport:showRenameExportedSymbolCommand",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "requireModuleSupport.goToDefinitionModule",
          "when": "editorLangId == javascript"
        },
        {
          "command": "requireModuleSupport.renameExportedSymbol",
          "when": "editorLangId == javascript"
        }
      ]
    }
  },
  "__metadata": {
    "id": "bff3fb6f-4e1e-4bd3-8666-4fdd15d9d45e",
    "publisherDisplayName": "Ferdinand Prantl",
    "publisherId": "0ced7712-5400-4aa1-b1d8-c377e01b0453",
    "isPreReleaseVersion": false
  }
}
